# ---------------------------------------------------------------------------
# EventBook API - environment variables
# Copy to `.env` for local development. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the *Session pooler* (port 5432) or *Transaction pooler* (port 6543) URL.
# Plain postgres:// URLs are accepted; the app switches to the psycopg driver.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of browser origins allowed to call the API.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# "development" or "production"
ENVIRONMENT=development

# Auth cookie flags.
#   Local (http, same machine):   COOKIE_SECURE=false  COOKIE_SAMESITE=lax
#   Production (https, Vercel <-> Render are different sites): COOKIE_SECURE=true  COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seed accounts (scripts/seed.py). Change these before seeding a real database.
SEED_ADMIN_EMAIL=admin@eventbook.dev
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=EventBook Admin
SEED_USER_EMAIL=user@eventbook.dev
SEED_USER_PASSWORD=User12345!
SEED_USER_NAME=Jane Attendee
